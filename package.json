{
  "name": "ai-dev-monorepo",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "test:suspensions": "pnpm --filter frontend test:suspensions",
    "test:moderation": "pnpm --filter frontend test:moderation",
    "admin:bootstrap": "pnpm --filter backend admin:bootstrap",
    "dev": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "typecheck": "pnpm -r --filter frontend --filter backend typecheck",
    "lint": "pnpm -r --filter frontend --filter backend lint",
    "build": "pnpm -r --filter frontend --filter backend build",
    "test:backend": "pnpm --filter backend test",
    "test:integration": "pnpm --filter backend test:integration",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --level warning --fail-on warning",
    "db:test": "supabase test db",
    "db:test:concurrency": "node supabase/tests/check-concurrency.mjs",
    "geography:import": "pnpm --filter backend geography:import",
    "geography:benchmark": "pnpm --filter backend geography:benchmark",
    "test:mock": "pnpm --filter frontend test:mock",
    "test:geography": "pnpm --filter frontend test:geography",
    "test:profiles": "pnpm --filter frontend test:profiles",
    "test:events": "pnpm --filter frontend test:events",
    "test:event-actions": "pnpm --filter frontend test:event-actions",
    "test:event-covers": "pnpm --filter frontend test:event-covers",
    "covers:setup": "pnpm --filter backend covers:setup",
    "invitations:setup": "pnpm --filter backend invitations:setup",
    "test:ui": "pnpm --filter frontend test:ui",
    "format": "pnpm --filter frontend format"
  },
  "devDependencies": {
    "supabase": "2.122.0"
  }
}

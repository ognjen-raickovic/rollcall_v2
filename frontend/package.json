{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:navigation-ui": "node --test scripts/check-navigation-discovery-ui.mjs",
    "test:discovery": "node --test scripts/check-discovery.mjs scripts/check-account-verification.mjs",
    "test:auth-experience-ui": "node --test scripts/check-auth-experience-ui.mjs",
    "test:account-ui": "node --test scripts/check-account-ui.mjs",
    "test:registration": "node --test scripts/check-registration-api.mjs",
    "test:registration-ui": "node --test scripts/check-registration-ui.mjs",
    "test:suspensions": "node --test scripts/check-suspensions-api.mjs",
    "test:moderation": "node --test scripts/check-moderation-api.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test:mock": "node --test scripts/check-mock-api.mjs",
    "test:geography": "node --test scripts/check-geography-api.mjs",
    "test:profiles": "node --test scripts/check-profiles-api.mjs",
    "test:events": "node --test scripts/check-events-api.mjs",
    "test:event-actions": "node --test scripts/check-event-actions.mjs",
    "test:event-covers": "node --test scripts/check-event-covers.mjs",
    "test:ui": "playwright test",
    "lint": "oxlint && node scripts/check-boundaries.mjs",
    "format": "prettier --write src",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}

# Development and local production preview proxy. This variable stays in Vite's server.
API_PROXY_TARGET=http://127.0.0.1:3001

# Browser requests use /api on the same origin by default.
# For separate hosting, set an HTTP(S) API origin and configure its allowed CORS origins.
# Never put Supabase private keys, database credentials or service-role keys here.
VITE_API_ORIGIN=

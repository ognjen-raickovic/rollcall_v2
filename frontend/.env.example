# Development and local production preview proxy. This variable stays in Vite's server.
API_PROXY_TARGET=http://127.0.0.1:3001

# Browser requests use /api on the same origin by default.
# Vercel/Render hosting keeps this empty and uses the reviewed same-origin /api rewrite.
# Vite's API_PROXY_TARGET affects development/preview only, not the deployed static app.
# Never put Supabase private keys, database credentials or service-role keys here.
VITE_API_ORIGIN=

# Local Supabase Auth only. Use the publishable/legacy anon key from local Supabase status.
# These values are public browser configuration; NEVER use a secret/service-role key.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional numeric mock-player picker. Vite production builds always disable this.
VITE_ENABLE_DEMO_MODE=false

# Copy to backend/.env. Nothing in this file is a real credential.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# Local values come from `pnpm exec supabase status` after `pnpm db:start`.
# Use its publishable key (or legacy anon key), NEVER its secret/service_role key.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
SUPABASE_TIMEOUT_MS=5000
CITY_SEARCH_DEFAULT_LIMIT=4
CITY_SEARCH_MAX_LIMIT=20

# Server-only cover-operation key. The local setup command generates this in backend/.env
# and stores only its hash in PostgreSQL. Never put it in frontend configuration.
# EVENT_COVER_OPERATION_KEY=

# Opt in only when running test:integration against local Supabase.
RUN_LOCAL_INTEGRATION=false

# Maintenance importer only: use the LOCAL DB_URL from Supabase status.
# The import command rejects remote hosts. This is never used by the Fastify API.
# GEOGRAPHY_DATABASE_URL=postgresql://postgres:replace-with-local-password@127.0.0.1:55322/postgres

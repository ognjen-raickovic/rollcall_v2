# Copy privately to backend/.staging/operator.env. Never change backend/.env.
# This is operator configuration, never Fastify or Vite configuration.
ROLLCALL_STAGING_PROJECT_NAME=rollcall-dev
ROLLCALL_STAGING_PROJECT_REF=replace-with-approved-project-ref
ROLLCALL_STAGING_SUPABASE_URL=https://replace-with-approved-project-ref.supabase.co
# Direct db.<ref>.supabase.co:5432 or session pooler :5432, from Dashboard Connect.
# Supply the credential privately. TLS verification is mandatory; no URI query options.
ROLLCALL_STAGING_DATABASE_URL=
# Optional downloaded project CA PEM; leave empty to use system trust.
ROLLCALL_STAGING_DATABASE_CA_FILE=
# Remains disabled throughout 6A-1. Enable only after separate 6A-2 authorization.
ROLLCALL_STAGING_WRITES_ENABLED=false

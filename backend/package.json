{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "staging:prepare": "node --env-file-if-exists=.staging/operator.env --import tsx scripts/staging/cli.ts",
    "admin:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/bootstrap-superadmin.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:production": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "lint": "oxlint --deny-warnings src tests scripts",
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test tests/integration/*.test.ts",
    "covers:setup": "node --env-file-if-exists=.env --import tsx scripts/setup-event-covers.ts",
    "invitations:setup": "node --env-file-if-exists=.env --import tsx scripts/setup-invitations.ts",
    "geography:import": "node --env-file-if-exists=.env --import tsx scripts/geography/import.ts",
    "geography:benchmark": "node --env-file-if-exists=.env --import tsx scripts/check-geography-performance.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@supabase/supabase-js": "2.118.0",
    "fastify": "5.12.7",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "fflate": "0.8.3",
    "oxlint": "^1.81.0",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "~6.0.2"
  }
}

{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "lint": "oxlint --deny-warnings src tests",
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "fastify": "5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.81.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.2"
  }
}
